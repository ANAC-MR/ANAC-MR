rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    //  ANAC SGV — Règles par RÔLE (custom claims Firebase)
    //  ─────────────────────────────────────────────────────────
    //  Le rôle fait autorité via request.auth.token.role, posé
    //  UNIQUEMENT par les Cloud Functions (SDK Admin). Le frontend
    //  (sessionStorage) n'a AUCUN pouvoir d'autorisation ici.
    //
    //  Rôles : 'admin' (tout) · 'reader' (lecture métier, aucune
    //  écriture) · 'operator' (défini mais non attribué aujourd'hui,
    //  traité comme reader ci-dessous — ajustable plus tard).
    //
    //  Source de vérité : ce fichier reflète les règles déployées en
    //  console. Déployer avec : firebase deploy --only firestore:rules
    // ═══════════════════════════════════════════════════════════

    function signedIn()  { return request.auth != null; }
    function role()      { return signedIn() ? request.auth.token.role : ''; }
    function isAdmin()   { return role() == 'admin'; }
    // Lecture métier autorisée : admin + reader + operator.
    function canRead()   { return isAdmin() || role() == 'reader' || role() == 'operator'; }

    // ── Comptes utilisateurs ──────────────────────────────────
    //  read  : chacun lit UNIQUEMENT son propre document ; l'admin
    //          peut tout lister. (Doc indexé par uid — option A.)
    //  write : INTERDIT au client (Cloud Functions uniquement).
    match /anac_users/{uid} {
      allow read:  if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // ── Journal d'activité ────────────────────────────────────
    //  create : réservé aux comptes RÉELS (admin/reader/operator).
    //           DURCISSEMENT sécurité (audit) : on exclut les sessions
    //           ANONYMES (carte publique) pour empêcher l'injection et
    //           l'inondation du journal par un jeton anonyme. Le
    //           login_success est journalisé APRÈS authentification,
    //           donc ce durcissement ne casse rien.
    //  read/gestion : admin uniquement.
    match /anac_activity_log/{doc} {
      allow create: if canRead();
      allow read, update, delete: if isAdmin();
    }

    // ── Carte publique : lecture ANONYME de schedules seulement ─
    //  Un visiteur non connecté (anonyme) peut LIRE schedules.
    //  Écriture réservée à l'admin.
    match /schedules/{doc} {
      allow read:  if signedIn();     // inclut l'anonyme de la carte publique
      allow write: if isAdmin();
    }

    // ── Données métier : lecture (admin/reader/operator), écriture ADMIN ─
    match /flights/{doc} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }
    match /flight_numbers/{doc} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }
    match /aircraft/{doc} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }
    match /airlines/{doc} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }
    match /ldm_archive/{doc} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }
    match /programme_vols/{doc} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }
    match /vol_pairs/{doc} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }
    match /ldm_config/{doc} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }

    // ── Toute autre collection : admin uniquement ─────────────
    //  (par défaut fermé ; plus de règle fourre-tout permissive)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
